#include <stdio.h>
#include <math.h>
int main() {
    int n, i = 2, ok = 1;
    scanf("%d", &n);
    if (n < 2) {
        printf("Ko nto");
    } else {
        while (i <= sqrt(n)) {
            if (n % i == 0) {
                ok = 0;
                break;
            }
            i++;
        }
        if (ok) printf("Co nto");
        else printf("Ko nto");
    }
    return 0;
}
